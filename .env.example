# ─────────────────────────────────────────────────────────────
# CIPAM IPR Translator — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5001
NODE_ENV=development

# PostgreSQL — your local database connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/cipam_ipr_db

# JWT Secret — must be a long random string (minimum 32 characters)
# Generate one by running: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string

# CORS — the URL where Person C's React frontend runs
# In development this is Vite's default port
FRONTEND_URL=http://localhost:3000

# Admin seeding — used ONLY by server/database/seed-admin.js
# Remove or comment out ADMIN_PASSWORD after running the seed script once.
ADMIN_EMAIL=admin@cipam.gov.in
ADMIN_NAME=CIPAM Administrator
ADMIN_PASSWORD=replace_this_with_a_strong_password
